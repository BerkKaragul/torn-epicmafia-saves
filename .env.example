# ── Supabase (from your project's Settings → API) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App secrets ───────────────────────────────────────────────────────
# 32-byte base64 key for AES-256-GCM encryption of stored Torn API keys.
# Generate with: openssl rand -base64 32   (must be identical on Vercel and Supabase)
API_KEY_ENC_KEY=
# Secret for signing session JWT cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# ── Torn ──────────────────────────────────────────────────────────────
# Override to point at the simulator during testing
TORN_API_BASE=https://api.torn.com/v2
FACTION_ID=40959

# ── Web Push (generate once with: npx web-push generate-vapid-keys) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
