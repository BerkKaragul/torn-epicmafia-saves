# ── Supabase (from your project's Settings → API) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App secrets ───────────────────────────────────────────────────────
# 32-byte base64 key for AES-256-GCM encryption of stored Torn API keys.
# Generate with: openssl rand -base64 32   (must be identical on Vercel and Supabase)
API_KEY_ENC_KEY=
# Secret for signing session JWT cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# ── Torn ──────────────────────────────────────────────────────────────
# Override to point at a simulator during testing. NOTE: the poller Edge
# Function reads its own copy — set it with `supabase secrets set` too if you
# want the poller redirected. The faction id lives in the DB (settings row).
TORN_API_BASE=https://api.torn.com/v2

# ── Web Push (generate BOTH values with: node scripts/generate-vapid.mjs) ──
# NEXT_PUBLIC_VAPID_PUBLIC_KEY goes here (and in Vercel env).
# VAPID_KEYS (the JSON JWK pair) is a Supabase function secret ONLY — it is
# never read by the Next app.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com
